FROM ghcr.io/dispatcharr/dispatcharr@sha256:f81924fa3dbfeb463b3908be7e086bf58aacbd2ba56062bfb555ee3a471acf8f

LABEL org.opencontainers.image.source="https://github.com/bdekonin/Dispatcharr"
COPY apps/proxy/vod_proxy/views.py /app/apps/proxy/vod_proxy/views.py
RUN /dispatcharrpy/bin/python -c "import ast, pathlib; ast.parse(pathlib.Path('/app/apps/proxy/vod_proxy/views.py').read_text())"
