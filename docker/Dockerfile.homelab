FROM ghcr.io/dispatcharr/dispatcharr@sha256:f81924fa3dbfeb463b3908be7e086bf58aacbd2ba56062bfb555ee3a471acf8f

LABEL org.opencontainers.image.source="https://github.com/bdekonin/Dispatcharr"
COPY apps/proxy/vod_proxy/views.py /app/apps/proxy/vod_proxy/views.py
COPY apps/proxy/vod_proxy/source_pin.py /app/apps/proxy/vod_proxy/source_pin.py
COPY apps/proxy/vod_proxy/multi_worker_connection_manager.py /app/apps/proxy/vod_proxy/multi_worker_connection_manager.py
RUN /dispatcharrpy/bin/python -c "import ast, pathlib; [ast.parse(p.read_text()) for p in pathlib.Path('/app/apps/proxy/vod_proxy').glob('*.py')]"
